# Monday Environment Configuration
# Copy this file to .env and fill in your API keys

# AI Provider API Keys
ANTHROPIC_API_KEY=your_anthropic_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here
QWEN_API_KEY=your_qwen_key_here

# Optional: Local model settings
LOCAL_MODEL_PATH=/path/to/local/model

# Monday Server Settings
MONDAY_HOST=localhost
MONDAY_PORT=8080

# Security
MONDAY_SECRET_KEY=generate_a_secure_random_key_here

# Android Companion
ANDROID_COMPANION_ENABLED=false
ANDROID_PAIRING_PORT=8081

# Logging
LOG_LEVEL=INFO
LOG_FILE=monday.log
